# Salin menjadi tunnel.env
# Pilih salah satu mode:

# --- Mode A: Cloudflare + domain sekolah (disarankan, link tetap) ---
TUNNEL_MODE=cloudflare
# Contoh: koding.smpm22pamulang.sch.id  (tambahkan CNAME di DNS sekolah)
PUBLIC_HOSTNAME=koding.smpm22pamulang.sch.id

# --- Mode B: LocalTunnel subdomain tetap (tanpa domain sekolah) ---
# TUNNEL_MODE=localtunnel
# PUBLIC_HOSTNAME=koding-smpm22
